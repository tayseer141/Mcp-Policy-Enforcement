OPENAI_API_KEY=your_openai_api_key_here

DB_HOST=db
DB_PORT=5432
DB_NAME=mcp_demo
DB_USER=mcp_user
DB_PASSWORD=mcp_pass

# --- Authentication ---------------------------------------------------
# Signs admin session cookies and API bearer tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me

# Shared secret between the web gateway and the MCP server. The MCP
# server rejects any request that doesn't present it.
MCP_GATEWAY_KEY=dev-gateway-key-change-me

# Admin session / bearer token lifetime in hours.
ADMIN_SESSION_TTL_HOURS=8

# true  = console may switch identities freely on /api/v1/execute
#         (classroom demo of RBAC differences between users).
# false = /api/v1/execute requires a Bearer token from
#         POST /api/v1/auth/login (production posture).
# The admin dashboard and MCP server are ALWAYS authenticated.
DEMO_MODE=true